{
    "nginx_config_path": "/etc/nginx/sites-available/generated.conf",
    "nginx_stream_config_path": "/etc/nginx/stream-enabled/generated-stream.conf",
    "nginx_ip": "XXX.XXX.XXX.XXX",

    "adguard_enabled": false,
    "adguard_url": "http://adguard.example.com",
    "adguard_username": "YOUR_ADGUARD_USERNAME",
    "adguard_password": "YOUR_ADGUARD_PASSWORD",

    "update_enabled": true,
    "update_branch": "main",
    "update_version_url": "https://raw.githubusercontent.com/racoon2code/proxy-manager/main/VERSION"
}